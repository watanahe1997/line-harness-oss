{
  "name": "line-oss-crm",
  "version": "0.24.1",
  "private": true,
  "description": "Open-source LINE Official Account CRM/marketing automation",
  "homepage": "https://the-harness.com/line-harness/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shudesu/line-harness-oss.git"
  },
  "bugs": {
    "url": "https://github.com/Shudesu/line-harness-oss/issues"
  },
  "author": {
    "name": "野田修一 (Shudesu)",
    "url": "https://the-harness.com/noda-shuichi/"
  },
  "scripts": {
    "plugin:create": "node examples/plugins/create-plugin.mjs",
    "dev:worker": "pnpm --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "deploy:worker": "pnpm --filter worker deploy",
    "deploy:web": "pnpm --filter web build",
    "db:migrate": "wrangler d1 execute your-database --file=packages/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute your-database --file=packages/db/schema.sql --local",
    "deploy:setup": "node packages/create-line-harness/dist/index.js",
    "deploy:update": "node packages/create-line-harness/dist/index.js update",
    "sandbox:create-line-harness": "bash scripts/run-create-line-harness-sandbox.sh",
    "test:scripts": "vitest run --config vitest.config.ts",
    "build:bundle": "tsx scripts/release/build-bundle.ts",
    "build:wfp-bundle": "tsx scripts/release/build-wfp-bundle.ts"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "4",
    "tsx": "^4.21.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.14",
      "express-rate-limit": "8.5.2",
      "fast-uri": "3.1.2",
      "form-data": "4.0.6",
      "ip-address": "10.1.1",
      "postcss": "8.5.10",
      "qs": "6.15.3"
    }
  }
}
